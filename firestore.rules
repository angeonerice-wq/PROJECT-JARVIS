rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // SVは特定店舗に紐づかず全スタッフを横断して担当するため、店舗による絞り込みは行わない。
    function isSv() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sv';
    }

    // SVによる報告への対応(承認/再調整依頼/エスカレーション)の書き込みを検証する。
    // 変更してよいのは reviewedBy/reviewedAt/reviewedAction と、承認時のみ付随する
    // approvedAt、任意コメントのreviewComment、再判定のたびにクリアするstaffAckAt
    // だけで、それ以外のフィールドの値が1つでも変わっていれば拒否する。
    function isValidReview() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(
               ['approvedAt', 'reviewedBy', 'reviewedAt', 'reviewedAction',
                'reviewComment', 'staffAckAt']
             )
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedAction is string
        && (!('approvedAt' in request.resource.data)
            || request.resource.data.approvedAt is timestamp)
        && (!('reviewComment' in request.resource.data)
            || request.resource.data.reviewComment is string);
    }

    // スタッフ本人が、SVからの判定(reviewedAction/reviewComment)を確認したことを
    // 記録するための例外。isValidConfirmation()(announcements向け)と同じ技法で、
    // staffAckAtフィールドのみを書き込める。
    function isValidStaffAck() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['staffAckAt'])
        && request.resource.data.staffAckAt is timestamp;
    }

    // SVが「⑤稼働確認」から配下スタッフの勤怠ステータスを手動変更する場合の例外。
    // 通常の書き込みは本人のstaffIdでの作成のみに限定しているが、この用途に限り
    // SVが対象スタッフのstaffIdで書き込めるようにする。悪用を防ぐため、
    // - isManualBySv:trueであること(この専用フラグを立てた書き込みのみ許可)
    // - supervisorIdが自分自身のuidであること(SV自身に固定、なりすまし防止)
    // - categoryが勤怠の4ステータスのいずれかであること(他カテゴリへの流用を防止)
    // - staffIdが実際に自分の配下スタッフ(supervisorId==自分)であること
    // の4点すべてを満たす場合のみ許可する。
    function isValidManualAttendance() {
      return isSv()
        && request.resource.data.isManualBySv == true
        && request.resource.data.supervisorId == request.auth.uid
        && request.resource.data.category in
             ['勤怠(出勤)', '勤怠(遅刻)', '勤怠(欠勤)', '勤怠(有給)']
        && request.resource.data.staffId is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.staffId))
             .data.supervisorId == request.auth.uid;
    }

    // SVが「送信したタスク」画面から配下スタッフのタスク完了を代理記録する場合の例外。
    // 口頭で完了報告を受けたがJARVISへの入力を忘れている場合等を想定。
    // isValidManualAttendance()と同じ悪用防止に加え、sourceTaskIdが実際に自分が
    // 割り当てたタスク(assignedBy==自分)であることも確認する。
    function isValidManualTaskCompletion() {
      return isSv()
        && request.resource.data.isManualBySv == true
        && request.resource.data.supervisorId == request.auth.uid
        && request.resource.data.category == 'タスク完了'
        && request.resource.data.staffId is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.staffId))
             .data.supervisorId == request.auth.uid
        && request.resource.data.sourceTaskId is string
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.sourceTaskId))
             .data.assignedBy == request.auth.uid;
    }

    // スタッフが作成した業務報告・チャット履歴。
    // 本人はいつでも自分の報告を作成・閲覧できる。SVは全スタッフの報告を閲覧できるが、
    // 書き込みは原則(SVであっても)本人のstaffIdでの作成のみに限定する。
    // 例外がisValidManualAttendance()(SVによる勤怠ステータスの手動変更)と
    // isValidManualTaskCompletion()(SVによるタスク完了の代理記録)。
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(
                         ['staffId', 'category', 'title', 'timestamp', 'action', 'fields', 'history']
                       )
                    && request.resource.data.category is string
                    && request.resource.data.title is string
                    && request.resource.data.timestamp is timestamp
                    && (request.resource.data.staffId == request.auth.uid
                        || isValidManualAttendance()
                        || isValidManualTaskCompletion());

      // SVが読めるのは「自分のチーム(supervisorId==自分)」のreportsのみに限定する。
      // 本人が自分の報告を読める条件はこれまでと変更なし。
      allow read: if request.auth != null &&
        (resource.data.staffId == request.auth.uid ||
         (isSv() && resource.data.supervisorId == request.auth.uid));

      allow update: if (isSv() && isValidReview())
                    || (request.auth != null
                        && resource.data.staffId == request.auth.uid
                        && isValidStaffAck());

      allow delete: if false;
    }

    // SVがスタッフへ割り当てるタスク。作成できるのはSVのみで、自分自身をassignedByとして
    // 記録する場合に限る。閲覧は割り当て先本人とSVのみ。作成後の内容変更・削除は現状想定
    // していないため許可しない(必要になれば別途検討する)。
    match /tasks/{taskId} {
      allow read: if request.auth != null &&
        (resource.data.staffId == request.auth.uid || isSv());

      allow create: if isSv()
                    && request.resource.data.assignedBy == request.auth.uid
                    && request.resource.data.keys().hasAll(
                         ['staffId', 'assignedBy', 'title', 'detail', 'createdAt']
                       )
                    && request.resource.data.staffId is string
                    && request.resource.data.title is string
                    && request.resource.data.detail is string
                    && request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }

    // 宛先スタッフ本人が「確認しました」を押した際に、confirmedAtのみを
    // 書き込めるようにする。isValidReview()と同じ技法(diffのaffectedKeysを
    // 限定フィールドのみに絞る)を、SVではなく宛先スタッフ本人向けに適用したもの。
    function isValidConfirmation() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['confirmedAt'])
        && request.resource.data.confirmedAt is timestamp;
    }

    // SVがスタッフへ配信するお知らせ。tasksと同じ形だが、完了/問い合わせの概念を
    // 持たない代わりに、宛先本人が自分でconfirmedAtを書き込める点がtasksと異なる。
    // SVも、自分が送信したお知らせ(sentBy==自分)に限り代理でconfirmedAtを
    // 書き込める(口頭で確認済みの報告を受けたが本人の操作を忘れている場合等を想定。
    // sentByが送信元SV自身を指すため、勤怠/タスク完了のようなチーム所属確認
    // (get()によるsupervisorId照合)は不要)。
    match /announcements/{announcementId} {
      allow read: if request.auth != null &&
        (resource.data.staffId == request.auth.uid || isSv());

      allow create: if isSv()
                    && request.resource.data.sentBy == request.auth.uid
                    && request.resource.data.keys().hasAll(
                         ['staffId', 'sentBy', 'title', 'body', 'createdAt']
                       )
                    && request.resource.data.staffId is string
                    && request.resource.data.title is string
                    && request.resource.data.body is string
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && isValidConfirmation()
                    && (resource.data.staffId == request.auth.uid
                        || (isSv() && resource.data.sentBy == request.auth.uid));

      allow delete: if false;
    }

    // スタッフ/SVのロールを保持するプロフィール。ロールの自己書き換えを防ぐため、
    // クライアントからの書き込みは一切許可しない(アカウント発行は管理者が行う)。
    // SVは、自分がsupervisorId(担当SV)として設定されているスタッフのプロフィールのみ
    // 閲覧できる(usersコレクション全体への読み取り権限は与えない)。
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         (isSv() && resource.data.supervisorId == request.auth.uid));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
